/*
 * secret.h.example — the ONE secrets file for all three firmwares.
 *
 * Copy to secret.h (git-ignored) and fill in. Included by node_a, node_b and
 * test_board. Every device joins the same AP, so the WiFi credentials are
 * defined here exactly once. The node-specific macros below are unused by the
 * other images (they are just #defines) — keep them all here, one file to edit.
 *
 * Addressing: devices take their IP from DHCP and are reached by HOSTNAME, not
 * a hardcoded IP. Each ESP32 registers its DHCP hostname (jk-node-a/-b, jk-test)
 * so your DHCP server (pfSense) can publish it in DNS; resolution uses
 * getaddrinfo(), which also accepts a .local mDNS name or a literal IP.
 */
#ifndef SECRET_H
#define SECRET_H

/* ---- WiFi (all devices, identical AP) ----------------------------------- */
#define WIFI_SSID       "your-ssid"
#define WIFI_PASS       "your-pass"

/* ---- Node A only: MQTT broker + BMS login PIN (spec §7/§10/§12) ---------- */
/* Broker by hostname. No username/password (broker allows anonymous). A .local
 * name resolves if the broker host runs mDNS/avahi (Linux/macOS do). */
#define MQTT_URI        "mqtt://broker.local:1883"
/* Real BMS login PIN(s). PINs seen in the wild: 1234 / 123456 (O-5). */
#define JK_LOGIN_PIN    "123456"

/* ---- Node B only: where Node A's tunnel server lives (spec §12) ---------- */
/* Node A registers the DHCP hostname "jk-node-a"; set NODE_A_HOST to the name
 * your DHCP/DNS actually serves for it — the FQDN (e.g. jk-node-a.localdomain,
 * match your pfSense domain), a .local name, or a literal IP all work. */
#define NODE_A_HOST     "jk-node-a.localdomain"
#define NODE_A_PORT     3760

#endif /* SECRET_H */
