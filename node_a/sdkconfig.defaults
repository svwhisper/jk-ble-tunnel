# Node A — any WiFi+BLE ESP32 (WROOM/WROVER fine; BLE central only, no BLE 5.0
# needed). External-antenna board recommended at the battery (spec §2/§13).

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Bluetooth: NimBLE, central role only ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# Concurrent central links: app-held unit + Node-RED round-robin (~3 budget).
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# 256, not 517: the JK BMS chunks notifies at 128 B and commands are 20 B; a
# big preferred MTU just multiplies per-connection buffer usage (~13 KB/link
# observed at 517 — three garage links ate ~40 KB of heap).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# --- FreeRTOS / watchdog ---
CONFIG_ESP_TASK_WDT_INIT=n            # we init TWDT ourselves with our tasks
CONFIG_FREERTOS_HZ=1000

# --- Networking ---
CONFIG_LWIP_TCP_NODELAY_DEFAULT=y
# Resolve *.local via mDNS in getaddrinfo (e.g. a broker.local MQTT host that
# runs avahi) — DHCP/DNS hostnames still resolve normally too.
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# --- Console over native USB (USB-Serial-JTAG) ---
# These C3 boards enumerate as usbmodem (native USB), not a UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Logs ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Flash / OTA (push updater, rollback-protected; added 2026-08-28) ---
# Boards are 4MB; dual-slot OTA layout is in partitions.csv. Rollback reverts a
# freshly-pushed image that never confirms itself healthy (see components/ota).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
