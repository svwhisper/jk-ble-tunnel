# Node A — any WiFi+BLE ESP32 (WROOM/WROVER fine; BLE central only, no BLE 5.0
# needed). External-antenna board recommended at the battery (spec §2/§13).

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Bluetooth: NimBLE, central role only ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# Concurrent central links: app-held unit + Node-RED round-robin (~3 budget).
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
# GATT client procs: default 4 is starvation-prone here — every keepalive read
# and with-response write burns one, and an op aimed at a dying module wedges
# its proc for 30 s (NimBLE then TERMINATES that link: BLE_GATTC_UNRESPONSIVE_
# TIMEOUT_MS). With 3-4 held links the pool exhausted and reads for healthy
# banks failed ENOMEM silently -> they slept ~30 s later (the one-crowned-bank
# churn storm, 2026-08-29). 16 = never contended.
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=16
# 256, not 517: the JK BMS chunks notifies at 128 B and commands are 20 B; a
# big preferred MTU just multiplies per-connection buffer usage (~13 KB/link
# observed at 517 — three garage links ate ~40 KB of heap).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# --- FreeRTOS / watchdog ---
CONFIG_ESP_TASK_WDT_INIT=n            # we init TWDT ourselves with our tasks
CONFIG_FREERTOS_HZ=1000

# --- Networking ---
CONFIG_LWIP_TCP_NODELAY_DEFAULT=y
# Resolve *.local via mDNS in getaddrinfo (e.g. a broker.local MQTT host that
# runs avahi) — DHCP/DNS hostnames still resolve normally too.
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# --- Console on UART0 ---
# S3 Gold Edition: the cabled port is the CH340 UART bridge, so console goes
# to UART0 (the C3 boards used native USB-Serial-JTAG; revisit if ported back).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- Logs ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Flash / OTA (push updater, rollback-protected) ---
# S3 Gold Edition: 16 MB flash; dual-slot OTA layout in partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- PSRAM (S3 Gold Edition: 8 MB embedded octal, AP_3v3) ---
# Buries the C3-era heap crises (45 KB transient spikes vs 8 MB pool).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Internal-RAM relief (2026-08-29: imin hit 23 BYTES with BLE armed — httpd
# start races and silent task-create failures all trace to this): small
# allocations no longer default to internal, the internal reserve doubles,
# and the NimBLE host heap moves to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
