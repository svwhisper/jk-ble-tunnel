# Node B — BLE 5.0 target (ESP32-C3 / S3 / C6) for four advertising sets
# (spec §5/§13). Peripheral role only.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Bluetooth: NimBLE, peripheral + extended advertising ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Extended advertising with four simultaneous advertising sets (spec §5/O-8).
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=4
# One app connection at a time (spec §5); a couple of slots for clean handoff.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
# 8 KB host-task stack: the default 4096 overflowed by ~130 B the moment a
# phone connected to the clone (Guru: Stack protection fault in nimble_host,
# 2026-08-29) — the GATT-mirror callbacks run on this task.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_NIMBLE_TASK_STACK_SIZE=8192

# --- FreeRTOS / watchdog ---
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_FREERTOS_HZ=1000

# --- Networking ---
CONFIG_LWIP_TCP_NODELAY_DEFAULT=y
# Resolve *.local via mDNS in getaddrinfo, so NODE_A_HOST may be a .local name
# as well as a DHCP/DNS hostname or literal IP.
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# Console over native USB (USB-Serial-JTAG) — these C3 boards enumerate as
# usbmodem (native USB), not a UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Flash / OTA (push updater, rollback-protected; added 2026-08-28) ---
# Boards are 4MB; dual-slot OTA layout is in partitions.csv. Rollback reverts a
# freshly-pushed image that never confirms itself healthy (see components/ota).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
