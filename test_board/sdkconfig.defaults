# Bench test board — any BLE-capable ESP32. Both roles compiled in; one is
# selected per boot over TCP. Enable central + peripheral + observer +
# broadcaster so a single image can emulate either the app or a BMS.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_TCP_NODELAY_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
